<!DOCTYPE html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ricette | Dott.ssa Sarah Branchesi</title>
    <link rel="stylesheet" href="/styles/main.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    />
  </head>
  <body>
    <%- include("partials/header.ejs") %>

    <!-- HERO SECTION -->
    <section class="hero-section py-5">
      <div class="container pt-2 text-center">
        <h1 class="display-5 fw-bold mb-3">Ricette Sane e Bilanciate</h1>
        <p class="lead text-muted">Scopri le idee in cucina per il tuo benessere.</p>
      </div>
<div class="container text-center">
        <div class="d-flex justify-content-center flex-wrap gap-2">
          
          <a href="/ricette?categoria=tutte" class="btn <%= categoriaAttiva === 'tutte' ? 'btn-primary-custom' : 'btn-outline-primary-custom' %> rounded-pill px-4">
            Tutte
          </a>
          <a href="/ricette?categoria=Primi piatti" class="btn <%= categoriaAttiva === 'Primi piatti' ? 'btn-primary-custom' : 'btn-outline-primary-custom' %> rounded-pill px-4">
            Primi piatti
          </a>
          <a href="/ricette?categoria=Secondi piatti" class="btn <%= categoriaAttiva === 'Secondi piatti' ? 'btn-primary-custom' : 'btn-outline-primary-custom' %> rounded-pill px-4">
            Secondi piatti
          </a>
          <a href="/ricette?categoria=Contorni" class="btn <%= categoriaAttiva === 'Contorni' ? 'btn-primary-custom' : 'btn-outline-primary-custom' %> rounded-pill px-4">
            Contorni
          </a>
          <a href="/ricette?categoria=Dolci e Colazioni" class="btn <%= categoriaAttiva === 'Dolci e Colazioni' ? 'btn-primary-custom' : 'btn-outline-primary-custom' %> rounded-pill px-4">
            Dolci e Colazioni
          </a>

        </div>
      </div>
    </section>

    <!-- GRIGLIA DELLE RICETTE (Logica EJS pura) -->
    <section class="py-5 bg-white">
      <div class="container">
        <div class="row g-4">
          
          <% if (locals.ricette && ricette.length > 0) { %>
            <% ricette.forEach(ricetta => { %>
              <div class="col-md-6 col-lg-4">
                <div class="feature-card h-100 shadow-sm bg-white overflow-hidden d-flex flex-column rounded-4 border">
                  
                  <div class="bg-light text-center overflow-hidden" style="height: 200px;">
                    <img src="<%= ricetta.immagine %>" alt="<%= ricetta.titolo %>" class="w-100 h-100 object-fit-cover">
                  </div>
                  
                  <div class="p-4 d-flex flex-column flex-grow-1 justify-content-between">
                    <div>
                      <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-primary-custom text-white small"><%= ricetta.categoria %></span>
                      </div>
                      <h3 class="fw-bold h5 mb-2"><%= ricetta.titolo %></h3>
                      <p class="text-muted small mb-3"><%= ricetta.descrizioneBreve %></p>
                    </div>

                    <a href="/ricette/<%= ricetta.id %>" class="btn btn-primary-custom btn-sm rounded-pill mt-2">
                      Leggi la ricetta <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                  </div>

                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="col-12 text-center py-5">
              <p class="text-muted">Nessuna ricetta trovata in questa categoria.</p>
            </div>
          <% } %>

        </div>
      </div>
    </section>

    <%- include("partials/footer.ejs") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
  </body>
</html>